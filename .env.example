# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection: gpt-4o-mini (recommended, fast & cost-effective), gpt-4o, or gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Default Summarization Style: standard, concise, bullet_points, executive
DEFAULT_SUMMARY_STYLE=standard

# Offline / Mock Mode (set to true to test without API costs or when no API key is available)
MOCK_MODE=false
